{
  "name": "Zaky & Agnes Wedding Admin",
  "short_name": "ZA Admin",
  "description": "Dashboard pengelola undangan pernikahan Zaky & Agnes.",
  "id": "/admin-app",
  "start_url": "/admin.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f6ece6",
  "theme_color": "#ead8cc",
  "orientation": "portrait-primary",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/admin-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Daftar Tamu",
      "short_name": "Tamu",
      "url": "/admin.html?source=pwa&tab=guests",
      "icons": [
        {
          "src": "/admin-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "RSVP",
      "short_name": "RSVP",
      "url": "/admin.html?source=pwa&tab=rsvp",
      "icons": [
        {
          "src": "/admin-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Reminder WhatsApp",
      "short_name": "Reminder",
      "url": "/admin.html?source=pwa&tab=reminder",
      "icons": [
        {
          "src": "/admin-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}